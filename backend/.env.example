# ── DataNova AI backend configuration ───────────────────────────────────────
# Copy this file to `.env` and adjust. Everything is optional — without a
# Gemini key the app runs in local-only mode (rule-based analysis) so the demo
# never hard-fails.

# Gemini API key (https://aistudio.google.com/apikey).
# When empty, the pipeline skips Gemini and uses the deterministic fallback.
GOOGLE_API_KEY=

# Primary Gemini model. Defaults to gemini-3.6-flash if unset.
MODEL_NAME=gemini-3.6-flash

# Optional comma-separated fallback models tried when the primary fails
# (e.g. 404 not found or quota errors).
# FALLBACK_MODEL_NAMES=gemini-3.6-pro,gemini-2.5-flash

# Override the local classifier escalation threshold (default 0.85, read from
# app/models/confidence_threshold.json).
# CONFIDENCE_THRESHOLD=0.85

# Force local-only mode even when a key is present (useful for demos/tests).
# LOCAL_ONLY=false
